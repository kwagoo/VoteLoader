{
  "name": "voteloader",
  "version": "1.0.0",
  "private": true,
  "description": "Upload a ballot CSV to Salesforce as Vote__c and VotePreference__c records.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test",
    "build:exe": "pkg package.json --sea --targets node22-win-x64 --output dist/VoteLoader.exe"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-session": "^1.18.2"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.14.1"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "node22-win-x64"
    ]
  }
}
